# Hand-maintained hardware configuration for a Proxmox VM (SeaBIOS,
# VirtIO SCSI single, VirtIO NIC). Filesystems are generated by
# ./disko.nix and must not be added here. If this file is ever
# regenerated, use `nixos-generate-config --no-filesystems`.
{
  lib,
  modulesPath,
  ...
}:

{
  imports = [
    (modulesPath + "/profiles/qemu-guest.nix")
  ];

  boot.initrd.availableKernelModules = [
    "ata_piix"
    "uhci_hcd"
    "virtio_pci"
    "virtio_scsi"
    "sd_mod"
    "sr_mod"
  ];

  # Legacy BIOS boot (Proxmox default SeaBIOS): no EFI disk and no Secure
  # Boot key handling needed. disko sets boot.loader.grub.devices from the
  # EF02 partition in ./disko.nix.
  boot.loader.grub.enable = true;

  nixpkgs.hostPlatform = lib.mkDefault "x86_64-linux";
}
