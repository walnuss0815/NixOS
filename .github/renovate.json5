{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
  ],

  // This repo's dependencies are pinned three different ways:
  //  - flake.nix inputs -> flake.lock, updated manually via
  //    `nix flake update`. Renovate's "nix" manager (still beta) only
  //    touches flake.lock, so it's explicitly disabled here rather than
  //    just relying on its upstream default of `enabled: false`.
  //  - the `nixpkgs-stable` input's release branch (e.g. nixos-26.05),
  //    tracked via the customManagers entry below instead, since that's
  //    a plain string bump the "nix" manager doesn't handle at all.
  //  - the tool versions vendored under pkgs/ (kubernetes-mcp-server,
  //    git-mcp-server, ssh-mcp, claude-swap), tracked below via
  //    customManagers instead.
  nix: {
    enabled: false,
  },

  // pkgs/git-mcp-server and pkgs/ssh-mcp each vendor a trimmed
  // package.json + package-lock.json purely so buildNpmPackage can fetch
  // their small set of *runtime* dependencies reproducibly (see the
  // comments in the respective default.nix). They aren't "our" project
  // dependencies to bump independently - letting Renovate's built-in npm
  // manager loose on them would just fight with the hand-trimmed
  // lockfiles. The tool version itself is tracked via the customManagers
  // entries below instead.
  packageRules: [
    {
      matchManagers: ['npm'],
      matchFileNames: ['pkgs/**'],
      enabled: false,
    },
  ],

  // Renovate can only bump the `version` string in each default.nix - it
  // has no way to compute the matching Nix `hash`/`npmDepsHash`. Each PR
  // below will therefore fail the `flake-check` CI job until the hash is
  // refreshed locally (e.g. rebuild with `lib.fakeHash` and copy the
  // "got: sha256-..." value back in, or `nix-prefetch-npm-deps` for the
  // vendored package-lock.json files) and pushed to the PR branch before
  // merging.
  customManagers: [
    {
      customType: 'regex',
      description: 'nixpkgs-stable release branch (tracks NixOS/nixpkgs stable tags, e.g. 26.05). See .github/workflows/renovate-update-lock.yml for the matching flake.lock refresh.',
      managerFilePatterns: ['/^flake\\.nix$/'],
      matchStrings: ['nixpkgs-stable\\.url = "github:NixOS/nixpkgs/nixos-(?<currentValue>[0-9]+\\.[0-9]+)";'],
      datasourceTemplate: 'github-tags',
      depNameTemplate: 'NixOS/nixpkgs',
      // NixOS/nixpkgs tags include plenty of non-release noise (-beta,
      // -pre, v192, black@..., etc.) alongside the clean "26.05"-style
      // final release tags. Anchoring on exactly two numeric groups
      // filters out everything except those final release tags.
      versioningTemplate: 'regex:^(?<major>\\d+)\\.(?<minor>\\d+)$',
    },
    {
      customType: 'regex',
      description: 'claude-swap version pin (GitHub release tags, vX.Y.Z)',
      managerFilePatterns: ['/^pkgs/claude-swap/default\\.nix$/'],
      matchStrings: ['version = "(?<currentValue>[^"]+)";'],
      datasourceTemplate: 'github-releases',
      depNameTemplate: 'realiti4/claude-swap',
      extractVersionTemplate: '^v(?<version>.*)$',
    },
    {
      customType: 'regex',
      description: 'kubernetes-mcp-server version pin (npm)',
      managerFilePatterns: ['/^pkgs/kubernetes-mcp-server/default\\.nix$/'],
      matchStrings: ['version = "(?<currentValue>[^"]+)";'],
      datasourceTemplate: 'npm',
      depNameTemplate: 'kubernetes-mcp-server',
    },
    {
      customType: 'regex',
      description: 'git-mcp-server version pin (npm)',
      managerFilePatterns: ['/^pkgs/git-mcp-server/default\\.nix$/'],
      matchStrings: ['version = "(?<currentValue>[^"]+)";'],
      datasourceTemplate: 'npm',
      depNameTemplate: '@cyanheads/git-mcp-server',
    },
    {
      customType: 'regex',
      description: 'ssh-mcp version pin (npm)',
      managerFilePatterns: ['/^pkgs/ssh-mcp/default\\.nix$/'],
      matchStrings: ['version = "(?<currentValue>[^"]+)";'],
      datasourceTemplate: 'npm',
      depNameTemplate: 'ssh-mcp',
    },
  ],
}
